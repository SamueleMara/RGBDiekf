+            with patch('tools.temporal_batch_runtime.atomic_json',side_effect=write):
+                dest=persist_batch_summary(out,fallback,[{'status':'NOT_RUN'}])
+            self.assertEqual(Path(dest),fallback/'batch_summary.json')

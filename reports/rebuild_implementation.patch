+Run with --output pointing to the ACTUAL full-scene results. Failure is deliberate
+until all evidence exists; neither initialization nor unit tests satisfy it.
+"""
+import argparse,json
+from pathlib import Path
+
+
+def audit(output):
+    r=output/'reports'
+    def read(name):
+        p=r/name
+        return json.loads(p.read_text()) if p.exists() else {}
+    dataset=read('dataset_validation.json');initial=read('initial_map.json');convergence=read('convergence_diagnostics.json')
+    history=convergence.get('history',[])
+    checks={
+        '15_full_real_scene_masks_timing':dataset.get('frames')==328 and dataset.get('cameras')==3 and dataset.get('foreground_valid_observations',0)>0 and dataset.get('masks_available') is True and dataset.get('resolved_fps')==25.,
+        '16_forward_RTS_reverse_second_forward':len(history)>=2 and all((r/f'outer_{k:03d}_geometry.json').exists() for k in (0,1)),
+        '17_compact_map_counts':0<initial.get('points',0)<dataset.get('foreground_valid_observations',0) and all('map_bytes' in row for row in history),
+        '18_geometry_trajectory_visual_outputs':all((output/name).exists() for name in ('canonical_map.ply','trajectory.npz','visual_debug/motion.html','visual_debug/early_cam0_rgb.png','visual_debug/middle_cam0_rgb.png','visual_debug/final_cam0_rgb.png')),
+        '19_common_objective_and_explicit_convergence_status':len(history)>=2 and convergence.get('status') in ('CONVERGED','NON_CONVERGED') and isinstance(convergence.get('converged'),bool) and all(row['accepted_energy']<=row['before_energy'] for row in history),
+        'raw_measurement_likelihood_equivalence_verified':read('covariance_audit.json').get('raw_measurement_likelihood_equivalence_verified') is True,
+        'source_correlations_joint_query_tests_verified':read('covariance_audit.json').get('selected_query_tests_passed') is True,
+    }
+    # Section 7 permits a NON_CONVERGED safety ceiling. This checks stage
+    # completion and reporting, not a claim that numerical stationarity passed.
+    for k in (0,1):
+        trace=r/f'outer_{k:03d}_forward_trace.jsonl';geometry=read(f'outer_{k:03d}_geometry.json')
+        rows=[json.loads(line) for line in trace.read_text().splitlines()[1:]] if trace.exists() else []
+        checks[f'outer_{k}_all_forward_frames']=len(rows)==dataset.get('frames') and [row['frame'] for row in rows]==list(range(dataset.get('frames',0)))
+        checks[f'outer_{k}_all_reverse_frames']=[row['frame'] for row in geometry.get('frames',[])]==list(range(dataset.get('frames',0)-1,-1,-1))
+    return checks
+
+
+if __name__=='__main__':
+    parser=argparse.ArgumentParser();parser.add_argument('--output',required=True,type=Path);args=parser.parse_args()
+    result=audit(args.output);print(json.dumps(result,indent=2))
+    raise SystemExit(0 if all(result.values()) else 1)

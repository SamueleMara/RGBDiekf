+"""Raw-ray noise regression: inference must not use overlapping interpolations."""
+import unittest
+import numpy as np
+from numpy.testing import assert_allclose
+from test_direct_rebuild import Scene,noise
+from rgbd.geometry import build_initial_map
+from rgbd.lie import State,exp
+from rgbd.objective import DirectFactors
+
+
+class RawMeasurementCovarianceAcceptance(unittest.TestCase):
+    def test_original_counterexample_requires_cross_covariance(self):
+        n=noise(Scene());sigma2=np.asarray(n.sensor['covariance_base'])[0,0]
+        interpolation=np.array([[.8,.2,0],[0,.8,.2]])
+        propagated=interpolation@(np.eye(3)*sigma2)@interpolation.T
+        assert_allclose(propagated,[[.0017,.0004],[.0004,.0017]],atol=1e-15)
+        self.assertFalse(np.allclose(propagated,np.eye(2)*sigma2))
+
+    def test_production_uses_raw_pixels_not_interpolated_neighbors(self):
+        scene=Scene(2,1);n=noise(scene);frame=scene.images[0][0]
+        frame.mask[:]=False;frame.mask[3,3:5]=True
+        model,_=build_initial_map(scene,n);model.ownership[:]=[0,1]
+        state=State(exp(np.array([.02,.01,.001,.001,.002,.001]))[None],np.zeros((1,6)))
+        f=DirectFactors(scene,n,{})
+        value,score,metric,stats=f.frame(state,model,0)
+        frame.rgb[~frame.mask]=1-frame.rgb[~frame.mask]
+        changed,g,a,newstats=f.frame(state,model,0)
+        assert_allclose(changed,value,atol=1e-12);assert_allclose(g,score,atol=1e-12);assert_allclose(a,metric,atol=1e-12)
+        self.assertEqual(stats['foreground'],2)
+
+
+if __name__=='__main__':unittest.main()

+"""Measured RGB-D rigid-motion initialization and pointwise ownership evidence."""
+import numpy as np
+from scipy.special import logsumexp
+from .lie import State, log, inverse
+from .progress import progress
+
+
+def weighted_rigid_fit(x,y,weights):
+    total=weights.sum()
+    if total<=np.finfo(float).eps: return np.eye(4)
+    a=np.sum(x*weights[:,None],axis=0)/total; b=np.sum(y*weights[:,None],axis=0)/total
+    u,_,v=np.linalg.svd((x-a).T@((y-b)*weights[:,None]))
+    r=v.T@np.diag([1,1,np.linalg.det(v.T@u.T)])@u.T
+    t=np.eye(4); t[:3,:3]=r; t[:3,3]=b-r@a
+    return t
+
+
+def _world(frame,uv):
+    ix=np.rint(uv[:,0]).astype(int); iy=np.rint(uv[:,1]).astype(int)
+    inside=(ix>=0)&(iy>=0)&(ix<frame.camera.width)&(iy<frame.camera.height)
+    ix=np.clip(ix,0,frame.camera.width-1); iy=np.clip(iy,0,frame.camera.height-1)
+    valid=inside & frame.valid[iy,ix]
+    z=frame.depth[iy,ix].astype(float); fx,fy,cx,cy=frame.camera.intrinsics
+    q=np.c_[z*(uv[:,0]-cx)/fx,z*(uv[:,1]-cy)/fy,z]
+    return (q-frame.camera.world_to_camera[:3,3])@frame.camera.world_to_camera[:3,:3],valid
+
+
+def rigid_motion_mixture(x,y,covariance,noise,iterations=20,motion_prior=None):
+    """Deterministic sampled rigid initializers, normalized Gaussian mixture fit.
+
+    The sample count is an initializer budget, not a geometry cap or residual
+    gate. Outliers use the documented broad geometry prior and return mixture.
+    """
+    from .geometry import log_gaussian
+    from scipy.special import logsumexp
+    n=len(x);variance=np.trace(covariance,axis1=1,axis2=2)/3
+    prior=np.asarray(noise.geometry['ownership_prior']);outlier=noise.sensor['no_return']
+    broad=covariance+2*np.asarray(noise.geometry['covariance'])[:3,:3]
+    static=log_gaussian(y-x,covariance)
+    bad=log_gaussian(y-x,broad)+np.log(outlier)
+    candidates=[np.eye(4),weighted_rigid_fit(x,y,1/variance)]
+    rng=np.random.default_rng(0)
+    for _ in range(128):
+        ids=rng.choice(n,3,replace=False)
+        candidates.append(weighted_rigid_fit(x[ids],y[ids],1/variance[ids]))
+    def quality(t):
+        moving=log_gaussian(y-(x@t[:3,:3].T+t[:3,3]),covariance)
+        return logsumexp(np.stack([static+np.log((1-outlier)*prior[0]),moving+np.log((1-outlier)*prior[1]),bad],axis=1),axis=1).sum()
+    if motion_prior is not None:
+        original_quality=quality
+        prior_t,prior_cov=motion_prior[0]
+        def quality(t):
+            d=log(t@inverse(prior_t))
+            return original_quality(t)-.5*d@np.linalg.solve(prior_cov,d)
+        candidates.append(prior_t)
+    best=max(candidates,key=quality)
+    increments=[best]
+    if noise.bodies>1:
+        from scipy.cluster.vq import kmeans2
+        _,groups=kmeans2(y-x,noise.bodies,minit='++',seed=0)
+        increments=[weighted_rigid_fit(x,y,(groups==b)/variance) for b in range(noise.bodies)]
+    for _ in range(iterations):
+        logs=np.column_stack([static]+[log_gaussian(y-(x@t[:3,:3].T+t[:3,3]),covariance) for t in increments])
+        logits=np.c_[logs+np.log((1-outlier)*prior),bad]
+        weights=np.exp(logits-logsumexp(logits,axis=1)[:,None])
+        updates=[weighted_rigid_fit(x,y,weights[:,b+1]/variance) for b in range(noise.bodies)]
+        if motion_prior is not None:
+            from .lie import skew,left_jacobian
+            rinv=np.linalg.inv(covariance)
+            for b in range(noise.bodies):
+                current=increments[b];target,pcov=motion_prior[b];pinv=np.linalg.inv(pcov)
+                for _ in range(5):
+                    transformed=x@current[:3,:3].T+current[:3,3]
+                    residual=transformed-y
+                    j=np.stack([np.c_[np.eye(3),-skew(p)] for p in transformed])
+                    w=weights[:,b+1];wj=rinv@j
+                    a=j.reshape(-1,6).T@(wj*w[:,None,None]).reshape(-1,6)
+                    g=np.einsum('nri,nrs,ns,n->i',j,rinv,residual,w)
+                    d=log(current@inverse(target));chart=np.linalg.inv(left_jacobian(d))
+                    a+=chart.T@pinv@chart;g+=chart.T@pinv@d
+                    step=-np.linalg.solve(a,g)
+                    from .lie import exp
+                    current=exp(step)@current
+                    if np.linalg.norm(step)<1e-9:break
+                updates[b]=current
+        change=sum(np.linalg.norm(log(a@inverse(b))) for a,b in zip(updates,increments))
+        increments=updates
+        if change<1e-9:break
+    return increments,weights
+
+
+def _feature_covariance(frame,uv,noise):
+    x,y=uv.T;ix=np.rint(x).astype(int);iy=np.rint(y).astype(int)
+    z=frame.depth[iy,ix].astype(float);fx,fy,cx,cy=frame.camera.intrinsics
+    jac=np.zeros((len(z),3,3));jac[:,0,0]=z/fx;jac[:,1,1]=z/fy
+    jac[:,:,2]=np.c_[(x-cx)/fx,(y-cy)/fy,np.ones(len(z))]
+    jac=frame.camera.world_to_camera[:3,:3].T@jac
+    covariance=np.broadcast_to(noise.pixel_covariance,(len(z),3,3)).copy()
+    covariance[:,2,2]=np.asarray(noise.sensor['covariance_base'])[3,3]+z*z*np.asarray(noise.sensor['covariance_depth_squared'])[3,3]
+    return jac@covariance@jac.transpose(0,2,1)
+
+
+def initialize_motion(dataset,noise):
+    """Optical flow is only a nominal initializer; it adds no posterior factors."""
+    import cv2
+    from scipy.cluster.vq import kmeans2
+    cv2.setNumThreads(1)
+    poses=[np.repeat(np.eye(4)[None],noise.bodies,axis=0)]

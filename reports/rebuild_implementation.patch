+"""Preserve a verified initialized boundary; optionally stop only its own job."""
+import argparse,hashlib,json,signal,time
+from pathlib import Path
+import numpy as np
+import psutil
+from rgbd.geometry import SurfelMap
+from rgbd.lie import State
+from rgbd.outer_loop import initialization_digest
+
+parser=argparse.ArgumentParser();parser.add_argument('--output',type=Path,required=True);parser.add_argument('--interrupt-own-validation',action='store_true');args=parser.parse_args()
+root=args.output.resolve();objective=root/'reports/initial_objective.json'
+while not objective.exists():time.sleep(10)
+record=json.loads((root/'checkpoint.json').read_text())
+if record['stage']!='initialized' or record['history']:raise RuntimeError('Not an initialized boundary; refusing to reuse its objective')
+value=json.loads(objective.read_text());audit=json.loads((root/'reports/dataset_validation.json').read_text())
+if len(value['frames'])!=audit['frames'] or sum(row['foreground'] for row in value['frames'])!=audit['foreground_observations']:
+    raise RuntimeError('Incomplete initial objective; all raw foreground observations are required')
+with np.load(root/record.get('arrays','checkpoint.npz')) as z:
+    model=SurfelMap(**{key:z[key].copy() for key in ('xyz','rgb','edges','covariance','ownership','existence','anchors')},cell_size=float(z['cell_size']))
+    states=[State(p,v) for p,v in zip(z['poses'],z['twists'])]
+previous=json.loads((root/'reports/initial_objective_context.json').read_text()) if (root/'reports/initial_objective_context.json').exists() else {}
+context={**previous,'fingerprint':record['fingerprint'],'state_digest':initialization_digest(model,states),'original_raw_foreground_observations':audit['foreground_observations'],'frames_cameras':audit['frames']*audit['cameras'],'count_per_original_observation':1,'purpose':'Cache of the same deterministic objective; never an additional likelihood/prior'}
+(root/'reports/initial_objective_context.json').write_text(json.dumps(context,indent=2)+'\n')
+print('Verified full initial objective:',value['energy'],context,flush=True)
+if args.interrupt_own_validation:
+    for process in psutil.process_iter(['pid','name','cmdline']):
+        cmd=process.info['cmdline'] or []
+        if process.info['name'].startswith('python') and 'main.py' in cmd and str(root) in cmd:
+            context.setdefault('initial_run_wall_seconds',time.time()-process.create_time())
+            context.setdefault('initial_run_started_epoch_seconds',process.create_time())
+            attempt={'pid':process.pid,'started_epoch_seconds':process.create_time(),'wall_seconds':time.time()-process.create_time()}
+            status=Path('/proc')/str(process.pid)/'status'
+            for line in status.read_text().splitlines():
+                if line.startswith('VmHWM:'):attempt['peak_rss_bytes']=int(line.split()[1])*1024
+            context.setdefault('interrupted_attempts',[]).append(attempt)
+            context['initial_run_peak_rss_bytes']=max(context.get('initial_run_peak_rss_bytes',0),attempt.get('peak_rss_bytes',0))
+            (root/'reports/initial_objective_context.json').write_text(json.dumps(context,indent=2)+'\n')
+            print('Stop at initialized boundary, preserve files; PID',process.pid,flush=True);process.send_signal(signal.SIGINT)

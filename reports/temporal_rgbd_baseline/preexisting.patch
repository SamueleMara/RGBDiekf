+    secs = [float(m.group(2)) for m in it]; done = int(it[-1].group(1))+1
+    left = (max_outer-done+1)*sum(secs)/len(secs)                                      # + the final linearization pass
+    return el/(el+left), f'temporal IEKS iter {done}/{max_outer} (cap)', left
 
 

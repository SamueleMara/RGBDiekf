+    i, n = int(fr[-1].group(1)), int(fr[-1].group(2))
+    if not it:
+        per_frame = el/i
+        left = (n-i)*per_frame+(max_outer+1)*T_ITER_FRAMES_PER_FRAME*n*per_frame

+                    error = float((np.abs(P.cpu().numpy()-exact)/(sd[:, :, None]*sd[:, None, :])).max())
+                    self.assertLess(error, 1e-14, (module.CHUNK_MAX, first_block, error)); self.assertEqual(profile['LDL_inertia'], [m, n])

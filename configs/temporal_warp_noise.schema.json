{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Temporal RGB-D warp error covariance and provenance (no numeric defaults)",
  "type": "object",
  "required": ["covariance_rgbd", "units", "assumption_class", "method"],
  "properties": {
    "model_version": {"type":"integer","enum":[1,2]},
    "covariance_semantics": {"const":"additional_conditional_warp_model_discrepancy"},
    "covariance_rgbd": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}, "description": "Must also be symmetric positive definite; code checks Cholesky. Entries have products of the stated variable units."},
    "units": {"const": ["encoded_rgb_0_1", "encoded_rgb_0_1", "encoded_rgb_0_1", "m"]},
    "assumption_class": {"type": "string", "minLength": 1},
    "method": {"type": "string", "minLength": 1}
  }
}

{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "title":"Temporal warp identifiability analysis; NOT an inference covariance file",
 "type":"object",
 "required":["model_version","status","covariance_semantics","covariance_rgbd","calibration_file_usable_for_inference","not_identifiable_reasons","data_sha256","source_code_sha256"],
 "properties":{
  "model_version":{"const":2},
  "status":{"const":"MODEL_DISCREPANCY_NOT_IDENTIFIABLE"},
  "covariance_semantics":{"const":"additional_conditional_warp_model_discrepancy"},
  "covariance_rgbd":{"type":"null"},
  "calibration_file_usable_for_inference":{"const":false},
  "not_identifiable_reasons":{"type":"array","minItems":1,"items":{"type":"string"}},
  "data_sha256":{"type":"string","minLength":64,"maxLength":64},
  "source_code_sha256":{"type":"string","minLength":64,"maxLength":64}
 }
}
